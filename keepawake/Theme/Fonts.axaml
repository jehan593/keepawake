<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same Martian Mono Nerd Font files as dnsw/linker-windows (copied, not shared — separate
         assemblies) — regular/bold share family "MartianMono NF", medium is its own separate family
         "MartianMono NF Med". -->
    <FontFamily x:Key="MartianMono">avares://keepawake/Fonts/#MartianMono NF</FontFamily>
    <FontFamily x:Key="MartianMonoMedium">avares://keepawake/Fonts/#MartianMono NF Med</FontFamily>

</ResourceDictionary>
