<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app-on.ico</ApplicationIcon>
    <AssemblyName>keepawake</AssemblyName>
    <RootNamespace>Keepawake</RootNamespace>
    <!-- The tray window/menu is hand-rolled Win32 (Native/Win32.cs) — WndProc is exposed to native
         code via an [UnmanagedCallersOnly] static method turned into a raw function pointer, which
         needs an unsafe context. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- asInvoker: SetThreadExecutionState (the one Win32 call this app actually makes) needs no
         elevation at all, unlike dnsw's netsh/port-53 split — a single unprivileged process is the
         entire app, no separate service. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Native AOT, same reasoning as dnsw/linker-windows: framework-dependent + PublishSingleFile
       bundles the whole untrimmed CoreCLR+BCL, AOT publishes a much smaller single native exe. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- No Avalonia/Skia/HarfBuzz here on purpose — the tray icon and its context menu are driven
       directly by Shell_NotifyIcon + an owner-drawn native popup menu (see Native/Win32.cs,
       Ui/TrayIcon.cs), which is what actually paints the menu shown in the tray (Windows never
       supplies its own themed chrome for it — see CLAUDE.md's Theme section). That gets the same
       Nord/Martian-Mono look as before without staging Skia's ~9MB + HarfBuzz's ~1.5MB native
       libraries for an app that never draws through them. -->
  <ItemGroup>
    <None Include="Assets\app-on.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\app-off.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\generate-icon.ps1" />
    <!-- Only the regular weight is ever drawn (see Ui/MenuTheme.cs) — martian_mono_bold.ttf/
         martian_mono_medium.ttf stay in Fonts/ unused, same as they were before this rewrite. -->
    <None Include="Fonts\martian_mono_regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
